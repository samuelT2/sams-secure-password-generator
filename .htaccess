# Own "not found" page (static, carries noindex itself; Apache keeps status 404)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  # "/" depends on Accept-Language (comfort redirect below) - caches must keep the variants apart.
  Header always merge Vary "Accept-Language" "expr=%{REQUEST_URI} =~ m#^/(index\.html)?$#"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Redirect HTTP and www to HTTPS without www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [QSA,R=301,L]

  # Language versions: "/" = English (x-default), "/de/" = German.
  # Comfort for humans only: browsers whose preferred language is German are sent from "/" to
  # "/de/" - temporarily (302), so "/" stays the English canonical URL. Crawlers send no
  # Accept-Language and stay on English. "?lang=en" (language switcher) skips the redirect.
  RewriteCond %{QUERY_STRING} !(^|&)lang=en(&|$) [NC]
  RewriteCond %{HTTP:Accept-Language} ^de [NC]
  RewriteRule ^$ /de/ [R=302,L]
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# CSS and JS are always referenced with "?v=<version>" (index.html, de/index.html, 404.html and
# CACHE_FILES in sw.js) - cache them for a year and bump the version whenever they change.
# Sections are applied in order; for sw.js the later block wins (its URL has no version, and
# the browser must see a new service worker right away).
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Icons, screenshots and the social preview have no version - 30 days
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages, sitemap, robots: always revalidate, so a deploy is visible at once
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </Files>
  # Manifest (no version): short, so icon changes reach installed apps soon
  <Files "manifest.json">
    Header set Cache-Control "public, max-age=3600"
  </Files>
</IfModule>

# Expires fallback for clients/proxies without Cache-Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/manifest+json "access plus 1 hour"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
</IfModule>

# ---------------------------------------------------------------------------
# Compression (adds "Vary: Accept-Encoding"; the Accept-Language Vary above stays)
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml \
      application/javascript text/javascript application/json application/manifest+json \
      image/svg+xml image/x-icon image/vnd.microsoft.icon
  </IfModule>
</IfModule>
